<?xml version="1.0"?>
<robot name="simple_pendulum">

  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="red"><color rgba="0.9 0.2 0.2 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="pendulum_link">
    <visual>
      <origin xyz="0 0 -0.5"/>
      <geometry><cylinder radius="0.01" length="1.0"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 -1.0"/>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="pendulum_joint" type="continuous">
    <parent link="base_link"/>
    <child link="pendulum_link"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
