<?xml version="1.0"?>
<package format="3"><name>ros2_classroom</name><version>2.0.0</version>
<description>ROS 2 basics with an RViz RoboParty model</description>
<maintainer email="classroom@example.com">Classroom</maintainer><license>MIT</license>
<buildtool_depend>ament_python</buildtool_depend>
<exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
